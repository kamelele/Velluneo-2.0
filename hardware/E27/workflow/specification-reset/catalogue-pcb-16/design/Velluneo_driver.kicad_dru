(version 1)
(rule "HW-clearance" (constraint clearance (min 0.250000mm)))
(rule "HW-track_width" (constraint track_width (min 0.300000mm)))
(rule "HW-hole_size" (constraint hole_size (min 0.300000mm)))
(rule "HW-annular_width" (constraint annular_width (min 0.200000mm)))
(rule "HW-edge_clearance" (constraint edge_clearance (min 0.500000mm)))
(rule "HW-SPATIAL-ISOLATION" (condition "A.intersectsArea('HW-SPATIAL-ISOLATION')") (constraint disallow track via pad zone))
(rule "HW-SCOPED-HV_QUIET" (condition "((A.NetName == '/BULK_POS' || A.NetName == '/DRAIN' || A.NetName == '/STARTUP_MID' || A.NetName == 'Net-(BR1-AC-Pad2)' || A.NetName == 'Net-(BR1-AC-Pad4)' || A.NetName == 'Net-(D1-K)' || A.NetName == 'Net-(F1-Pad1)' || A.NetName == 'Net-(F1-Pad2)') && (B.NetName == '/AUX_RAW' || B.NetName == '/CS' || B.NetName == '/DRV' || B.NetName == '/GATE' || B.NetName == '/NTC' || B.NetName == '/PRIMARY_GND' || B.NetName == '/SENSE' || B.NetName == '/VDD' || B.NetName == '/VS' || B.NetName == 'Net-(D2-K)')) || ((A.NetName == '/AUX_RAW' || A.NetName == '/CS' || A.NetName == '/DRV' || A.NetName == '/GATE' || A.NetName == '/NTC' || A.NetName == '/PRIMARY_GND' || A.NetName == '/SENSE' || A.NetName == '/VDD' || A.NetName == '/VS' || A.NetName == 'Net-(D2-K)') && (B.NetName == '/BULK_POS' || B.NetName == '/DRAIN' || B.NetName == '/STARTUP_MID' || B.NetName == 'Net-(BR1-AC-Pad2)' || B.NetName == 'Net-(BR1-AC-Pad4)' || B.NetName == 'Net-(D1-K)' || B.NetName == 'Net-(F1-Pad1)' || B.NetName == 'Net-(F1-Pad2)'))") (constraint clearance (min 3.000000mm)))
(rule "HW-SCOPED-PRIMARY_SECONDARY" (condition "((A.NetName == '/AUX_RAW' || A.NetName == '/BLEED_MID_B' || A.NetName == '/BULK_POS' || A.NetName == '/CS' || A.NetName == '/DRAIN' || A.NetName == '/DRV' || A.NetName == '/GATE' || A.NetName == '/NTC' || A.NetName == '/PRIMARY_GND' || A.NetName == '/SENSE' || A.NetName == '/STARTUP_MID' || A.NetName == '/VDD' || A.NetName == '/VS' || A.NetName == 'Net-(BR1-AC-Pad2)' || A.NetName == 'Net-(BR1-AC-Pad4)' || A.NetName == 'Net-(D1-K)' || A.NetName == 'Net-(D2-K)' || A.NetName == 'Net-(F1-Pad1)' || A.NetName == 'Net-(F1-Pad2)' || A.NetName == 'Net-(R2-Pad2)') && (B.NetName == '/OUTPUT_NEG' || B.NetName == '/OUTPUT_POS' || B.NetName == '/SECONDARY_RAW' || B.NetName == 'unconnected-(T1-Pad7)' || B.NetName == 'unconnected-(T1-Pad8)' || B.NetName == 'unconnected-(T1-Pad9)')) || ((A.NetName == '/OUTPUT_NEG' || A.NetName == '/OUTPUT_POS' || A.NetName == '/SECONDARY_RAW' || A.NetName == 'unconnected-(T1-Pad7)' || A.NetName == 'unconnected-(T1-Pad8)' || A.NetName == 'unconnected-(T1-Pad9)') && (B.NetName == '/AUX_RAW' || B.NetName == '/BLEED_MID_B' || B.NetName == '/BULK_POS' || B.NetName == '/CS' || B.NetName == '/DRAIN' || B.NetName == '/DRV' || B.NetName == '/GATE' || B.NetName == '/NTC' || B.NetName == '/PRIMARY_GND' || B.NetName == '/SENSE' || B.NetName == '/STARTUP_MID' || B.NetName == '/VDD' || B.NetName == '/VS' || B.NetName == 'Net-(BR1-AC-Pad2)' || B.NetName == 'Net-(BR1-AC-Pad4)' || B.NetName == 'Net-(D1-K)' || B.NetName == 'Net-(D2-K)' || B.NetName == 'Net-(F1-Pad1)' || B.NetName == 'Net-(F1-Pad2)' || B.NetName == 'Net-(R2-Pad2)'))") (constraint clearance (min 10.700000mm)))
