(version 1)
# Unapproved ECO geometry; numeric3/10mm screens retained. No safety/process acceptance.
(rule "PROPOSED_PS_10mm" (condition "((A.NetName == 'Net-(F1-Pad2)' || A.NetName == '/AUX_RAW' || A.NetName == '/BULK_POS' || A.NetName == '/CS' || A.NetName == '/PRIMARY_GND' || A.NetName == '/GATE' || A.NetName == '/VS' || A.NetName == 'Net-(R2-Pad2)' || A.NetName == '/SENSE' || A.NetName == 'Net-(D1-K)' || A.NetName == 'Net-(BR1-AC-Pad4)' || A.NetName == '/NTC' || A.NetName == 'Net-(BR1-AC-Pad2)' || A.NetName == '/BLEED_MID_B' || A.NetName == '/DRAIN' || A.NetName == 'Net-(F1-Pad1)' || A.NetName == 'Net-(D2-K)' || A.NetName == '/STARTUP_MID' || A.NetName == '/DRV' || A.NetName == '/VDD' || A.NetName == 'unconnected-(T1-Pad3)') && (B.NetName == '/OUTPUT_POS' || B.NetName == '/OUTPUT_NEG' || B.NetName == '/SECONDARY_RAW' || B.NetName == 'unconnected-(T1-Pad7)' || B.NetName == 'unconnected-(T1-Pad8)' || B.NetName == 'unconnected-(T1-Pad9)')) || ((A.NetName == '/OUTPUT_POS' || A.NetName == '/OUTPUT_NEG' || A.NetName == '/SECONDARY_RAW' || A.NetName == 'unconnected-(T1-Pad7)' || A.NetName == 'unconnected-(T1-Pad8)' || A.NetName == 'unconnected-(T1-Pad9)') && (B.NetName == 'Net-(F1-Pad2)' || B.NetName == '/AUX_RAW' || B.NetName == '/BULK_POS' || B.NetName == '/CS' || B.NetName == '/PRIMARY_GND' || B.NetName == '/GATE' || B.NetName == '/VS' || B.NetName == 'Net-(R2-Pad2)' || B.NetName == '/SENSE' || B.NetName == 'Net-(D1-K)' || B.NetName == 'Net-(BR1-AC-Pad4)' || B.NetName == '/NTC' || B.NetName == 'Net-(BR1-AC-Pad2)' || B.NetName == '/BLEED_MID_B' || B.NetName == '/DRAIN' || B.NetName == 'Net-(F1-Pad1)' || B.NetName == 'Net-(D2-K)' || B.NetName == '/STARTUP_MID' || B.NetName == '/DRV' || B.NetName == '/VDD' || B.NetName == 'unconnected-(T1-Pad3)'))") (constraint clearance (min 10 mm)))
(rule "PROPOSED_HV_QUIET_3mm" (condition "((A.NetName == 'Net-(F1-Pad1)' || A.NetName == 'Net-(BR1-AC-Pad2)' || A.NetName == 'Net-(F1-Pad2)' || A.NetName == 'Net-(BR1-AC-Pad4)' || A.NetName == '/BULK_POS' || A.NetName == '/DRAIN' || A.NetName == 'Net-(D1-K)' || A.NetName == '/STARTUP_MID') && (B.NetName == '/VDD' || B.NetName == '/VS' || B.NetName == '/NTC' || B.NetName == '/CS' || B.NetName == '/DRV' || B.NetName == '/GATE' || B.NetName == '/SENSE' || B.NetName == '/PRIMARY_GND' || B.NetName == '/AUX_RAW' || B.NetName == 'Net-(D2-K)')) || ((A.NetName == '/VDD' || A.NetName == '/VS' || A.NetName == '/NTC' || A.NetName == '/CS' || A.NetName == '/DRV' || A.NetName == '/GATE' || A.NetName == '/SENSE' || A.NetName == '/PRIMARY_GND' || A.NetName == '/AUX_RAW' || A.NetName == 'Net-(D2-K)') && (B.NetName == 'Net-(F1-Pad1)' || B.NetName == 'Net-(BR1-AC-Pad2)' || B.NetName == 'Net-(F1-Pad2)' || B.NetName == 'Net-(BR1-AC-Pad4)' || B.NetName == '/BULK_POS' || B.NetName == '/DRAIN' || B.NetName == 'Net-(D1-K)' || B.NetName == '/STARTUP_MID'))") (constraint clearance (min 3 mm)))
