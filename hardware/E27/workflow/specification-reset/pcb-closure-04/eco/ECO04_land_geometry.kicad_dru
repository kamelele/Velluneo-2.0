(rule "DRAFT_PRIMARY_SECONDARY_10mm_NOMINAL" (condition "((A.NetName == 'Net-(F1-Pad1)' || A.NetName == 'Net-(BR1-AC-Pad2)' || A.NetName == 'Net-(F1-Pad2)' || A.NetName == 'Net-(BR1-AC-Pad4)' || A.NetName == '/AUX_RAW' || A.NetName == 'Net-(D2-K)' || A.NetName == 'Net-(R2-Pad2)' || A.NetName == '/BLEED_MID_B' || (A.NetName == '/BULK_POS' || A.NetName == '/STARTUP_MID') || A.NetName == 'Net-(D1-K)' || A.NetName == '/CS' || A.NetName == '/DRAIN' || A.NetName == '/DRV' || A.NetName == '/GATE' || A.NetName == '/NTC' || A.NetName == '/PRIMARY_GND' || A.NetName == '/SENSE' || A.NetName == '/VDD' || A.NetName == '/VS' || A.NetName == 'unconnected-(T1-Pad3)') && (B.NetName == '/OUTPUT_POS' || B.NetName == '/OUTPUT_NEG' || B.NetName == '/SECONDARY_RAW' || B.NetName == 'unconnected-(T1-Pad7)' || B.NetName == 'unconnected-(T1-Pad8)' || B.NetName == 'unconnected-(T1-Pad9)')) || ((A.NetName == '/OUTPUT_POS' || A.NetName == '/OUTPUT_NEG' || A.NetName == '/SECONDARY_RAW' || A.NetName == 'unconnected-(T1-Pad7)' || A.NetName == 'unconnected-(T1-Pad8)' || A.NetName == 'unconnected-(T1-Pad9)') && (B.NetName == 'Net-(F1-Pad1)' || B.NetName == 'Net-(BR1-AC-Pad2)' || B.NetName == 'Net-(F1-Pad2)' || B.NetName == 'Net-(BR1-AC-Pad4)' || B.NetName == '/AUX_RAW' || B.NetName == 'Net-(D2-K)' || B.NetName == 'Net-(R2-Pad2)' || B.NetName == '/BLEED_MID_B' || (B.NetName == '/BULK_POS' || B.NetName == '/STARTUP_MID') || B.NetName == 'Net-(D1-K)' || B.NetName == '/CS' || B.NetName == '/DRAIN' || B.NetName == '/DRV' || B.NetName == '/GATE' || B.NetName == '/NTC' || B.NetName == '/PRIMARY_GND' || B.NetName == '/SENSE' || B.NetName == '/VDD' || B.NetName == '/VS' || B.NetName == 'unconnected-(T1-Pad3)'))") (constraint clearance (min 10 mm)))
(rule "DRAFT_PRIMARY_HV_QUIET_3mm_UNRESOLVED" (condition "((A.NetName == 'Net-(F1-Pad1)' || A.NetName == 'Net-(BR1-AC-Pad2)' || A.NetName == 'Net-(F1-Pad2)' || A.NetName == 'Net-(BR1-AC-Pad4)' || (A.NetName == '/BULK_POS' || A.NetName == '/STARTUP_MID') || A.NetName == '/DRAIN' || A.NetName == 'Net-(D1-K)') && (B.NetName == '/VDD' || B.NetName == '/VS' || B.NetName == '/NTC' || B.NetName == '/CS' || B.NetName == '/DRV' || B.NetName == '/GATE' || B.NetName == '/SENSE' || B.NetName == '/PRIMARY_GND' || B.NetName == '/AUX_RAW' || B.NetName == 'Net-(D2-K)')) || ((A.NetName == '/VDD' || A.NetName == '/VS' || A.NetName == '/NTC' || A.NetName == '/CS' || A.NetName == '/DRV' || A.NetName == '/GATE' || A.NetName == '/SENSE' || A.NetName == '/PRIMARY_GND' || A.NetName == '/AUX_RAW' || A.NetName == 'Net-(D2-K)') && (B.NetName == 'Net-(F1-Pad1)' || B.NetName == 'Net-(BR1-AC-Pad2)' || B.NetName == 'Net-(F1-Pad2)' || B.NetName == 'Net-(BR1-AC-Pad4)' || (B.NetName == '/BULK_POS' || B.NetName == '/STARTUP_MID') || B.NetName == '/DRAIN' || B.NetName == 'Net-(D1-K)'))") (constraint clearance (min 3 mm)))
