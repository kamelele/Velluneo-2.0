(version 1)
(rule "HW-clearance" (constraint clearance (min 0.300000mm)))
(rule "HW-track_width" (constraint track_width (min 0.300000mm)))
(rule "HW-hole_size" (constraint hole_size (min 0.300000mm)))
(rule "HW-annular_width" (constraint annular_width (min 0.200000mm)))
(rule "HW-edge_clearance" (constraint edge_clearance (min 4.000000mm)))
(rule "HW-NETCLASS-AC_BUS" (condition "A.NetClass == 'AC_BUS'") (constraint track_width (min 0.6mm)))
(rule "HW-SPATIAL-EDGE_TOP" (condition "A.intersectsArea('HW-SPATIAL-EDGE_TOP')") (constraint disallow track via pad zone))
(rule "HW-SPATIAL-EDGE_BOTTOM" (condition "A.intersectsArea('HW-SPATIAL-EDGE_BOTTOM')") (constraint disallow track via pad zone))
(rule "HW-SPATIAL-EDGE_LEFT" (condition "A.intersectsArea('HW-SPATIAL-EDGE_LEFT')") (constraint disallow track via pad zone))
(rule "HW-SPATIAL-EDGE_RIGHT" (condition "A.intersectsArea('HW-SPATIAL-EDGE_RIGHT')") (constraint disallow track via pad zone))
(rule "HW-SPATIAL-CLAMP_TL" (condition "A.intersectsArea('HW-SPATIAL-CLAMP_TL')") (constraint disallow track via pad zone))
(rule "HW-SPATIAL-CLAMP_TR" (condition "A.intersectsArea('HW-SPATIAL-CLAMP_TR')") (constraint disallow track via pad zone))
(rule "HW-SPATIAL-CLAMP_BL" (condition "A.intersectsArea('HW-SPATIAL-CLAMP_BL')") (constraint disallow track via pad zone))
(rule "HW-SPATIAL-CLAMP_BR" (condition "A.intersectsArea('HW-SPATIAL-CLAMP_BR')") (constraint disallow track via pad zone))
