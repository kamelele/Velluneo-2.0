  "normal_source_function": "def normal(vac=230.,Rin=440.,Cin=430e-9,Cout=120e-6,duration=2.,Rs=28.7,Cfb=44e-6,L=.003,f=66000.,ilim=.375,vth=1.65,tmin=.5e-6):\n T=1/f;tau=Rs*Cfb; i=cf=v=bus=0.;N=round(f*duration);start=N//2;vmax=0.;vmin=1e9;ql=qsum=i2sum=0.;pk=0.;busmax=0.;gap=gmax=0.\n for n in range(N):\n  vrect=max(0.,math.sqrt(2)*vac*abs(math.sin(2*math.pi*50*n*T))-1.6);vin=max(0.,bus-1.7);qa=ton=0.\n  if cf<vth and vin>v:\n   a=(vin-v)/L;ton=min(.69*T,max(tmin,(ilim-i)/a));j=i+a*ton;qa=(i+j)*ton/2;i=j;cf*=math.exp(-ton/tau)\n  a=(v+1+max(cf,0.))/L;tf=min(T-ton,i/a);j=max(0.,i-a*tf);qb=(i+j)*tf/2;cf=(cf-Rs*i-Rs*a*tau)*math.exp(-tf/tau)+Rs*(i-a*tf+a*tau);cf*=math.exp(-(T-ton-tf)/tau);i=j\n  q=qa+qb;led=max(0.,v-84.5)/470.;load=led+max(0.,v-12.15)/4290+2*v/56000+v/321000+.00145;v=max(0.,v+(q-load*T)/Cout)\n  if vrect>bus:\n   # Analytic RC update for converter input charge averaged over T; exact isource\u00b2 integral in conduction region.\n   z=qa/T; y=(vrect-bus)/Rin-z; k=Rin*Cin; ex=math.exp(-T/k);src2=z*z*T+2*z*y*k*(1-ex)+y*y*k/2*(1-ex*ex); bus=vrect-Rin*z+(bus-vrect+Rin*z)*ex\n  else:src2=0.;bus=max(0.,bus-qa/Cin)\n  if n>=start:\n   vmax=max(vmax,v);vmin=min(vmin,v);ql+=led*T;qsum+=q;i2sum+=src2;busmax=max(busmax,bus);gap=gap+T if q<1e-15 else 0.;gmax=max(gmax,gap)\n dt=(N-start)*T;irms=math.sqrt(i2sum/dt)\n return dict(Vac=vac,Rin=Rin,Cin=Cin,Cout=Cout,duration=duration,Rsense=Rs,Cfb=Cfb,L=L,f=f,ilim=ilim,vth=vth,Coutmax=vmax,Coutmin=vmin,LEDavg=ql/dt,driveravg=qsum/dt,RFtotalW=irms*irms*Rin,RF_each_equal_nom_W=irms*irms*Rin/2,bridge_RMS=irms,busmax=busmax,max_chargegap=gmax)\n\n",
