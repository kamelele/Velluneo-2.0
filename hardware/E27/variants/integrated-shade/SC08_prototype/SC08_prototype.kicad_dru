(version 1)
(rule "HW-clearance" (constraint clearance (min 0.200000mm)))
(rule "HW-track_width" (constraint track_width (min 0.200000mm)))
(rule "HW-hole_size" (constraint hole_size (min 0.300000mm)))
(rule "HW-annular_width" (constraint annular_width (min 0.200000mm)))
(rule "HW-edge_clearance" (constraint edge_clearance (min 0.400000mm)))
